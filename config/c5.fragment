# Stock FlashForge kernel 2.0.7 (from c5-usb-serial-modules: vermagic and exports)
CONFIG_LOCALVERSION="+"
CONFIG_HIGHMEM=y
# Swap: compressed in RAM (zram) or a swap file on /usr/data
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
# Accept both legacy-NaN and 2008-NaN programs (replaces 01-fixnan.sh's devmem write)
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="ieee754=relaxed"
# So the next kernel's config can be read back from /proc/config.gz
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# The board device tree: FlashForge's own (dts/creator5_stock.dts)
CONFIG_DT_X2600_MODULE_BASE_DTS_FILE="creator5_stock.dts"
# Less debug overhead. Only options that don't change structures FlashForge's
# modules use: DEBUG_SPINLOCK (spinlock_t) and DETECT_HUNG_TASK (task_struct) stay.
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_NOTIFIERS is not set
# Boot messages on the touchscreen: c5-kexec.sh adds console=tty0 and fbcon=rotate,
# OpenCreator's UI scripts hand the screen back before the UI starts
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# Selects the generic drawing helpers patch 0005 gives FlashForge's jzfb, which
# has none (no simple-framebuffer node exists, so the driver itself stays idle)
CONFIG_FB_SIMPLE=y
