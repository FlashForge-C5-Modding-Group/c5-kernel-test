--- a/drivers/video/fbdev/core/fbmem.c
+++ b/drivers/video/fbdev/core/fbmem.c
@@ -33,6 +33,7 @@
 #include <linux/efi.h>
 #include <linux/fb.h>
 #include <linux/fbcon.h>
+#include <linux/io.h>
 #include <linux/mem_encrypt.h>
 #include <linux/pci.h>
 
@@ -1603,14 +1604,95 @@
 MODULE_PARM_DESC(lockless_register_fb,
 	"Lockless framebuffer registration for debugging [default=off]");
 
+#if IS_BUILTIN(CONFIG_FB_CFB_FILLRECT) && IS_BUILTIN(CONFIG_FB_CFB_COPYAREA) && \
+	IS_BUILTIN(CONFIG_FB_CFB_IMAGEBLIT)
+/*
+ * Some closed drivers (FlashForge's jzfb in soc_fb.ko) register without drawing
+ * operations, as only user space drew on them. The framebuffer console calls
+ * them, so give such drivers the generic memory-mapped ones, in a copy of their
+ * fb_ops (the driver's own table stays untouched), and the 16-colour palette
+ * those look true colour up in if the driver has none. The copies live as long
+ * as the kernel: such drivers are never unloaded.
+ *
+ * The console takes such a framebuffer over a second after it registers, with
+ * only the console lock held, as the FBIOPUT_CON2FBMAP ioctl does: taking it
+ * over during registration, with fb_info->lock held too, hangs jzfb.
+ */
+static struct fb_info *late_console_fb;
+
+static void fb_late_console_work(struct work_struct *work)
+{
+	mutex_lock(&registration_lock);
+	console_lock();
+	if (late_console_fb && registered_fb[late_console_fb->node] == late_console_fb)
+		fbcon_fb_registered(late_console_fb);
+	console_unlock();
+	mutex_unlock(&registration_lock);
+}
+static DECLARE_DELAYED_WORK(fb_late_console, fb_late_console_work);
+
+/* Returns whether it gave @info the generic operations */
+static bool fb_add_missing_drawing_ops(struct fb_info *info)
+{
+	const struct fb_cmap *cmap = fb_default_cmap(16);
+	struct fb_ops *ops;
+	u32 *pal = NULL;
+	int i;
+
+	if (!info->fbops || (info->fbops->fb_fillrect && info->fbops->fb_copyarea &&
+			     info->fbops->fb_imageblit))
+		return false;
+	if (!info->screen_base && info->fix.smem_start && info->fix.smem_len)
+		info->screen_base = ioremap_wc(info->fix.smem_start, info->fix.smem_len);
+	if (!info->screen_base) {
+		pr_warn("fb: %s has no drawing operations and no mapping; the console can't use it\n",
+			info->fix.id);
+		return false;
+	}
+	ops = kmemdup(info->fbops, sizeof(*ops), GFP_KERNEL);
+	if (!ops)
+		return false;
+	if (!info->pseudo_palette && (info->fix.visual == FB_VISUAL_TRUECOLOR ||
+				      info->fix.visual == FB_VISUAL_DIRECTCOLOR)) {
+		pal = kcalloc(16, sizeof(*pal), GFP_KERNEL);
+		if (!pal) {
+			kfree(ops);
+			return false;
+		}
+		/* The default console colours in the driver's pixel format, fully opaque */
+		for (i = 0; i < 16; i++)
+			pal[i] = (cmap->red[i] >> (16 - info->var.red.length)) << info->var.red.offset |
+				 (cmap->green[i] >> (16 - info->var.green.length)) << info->var.green.offset |
+				 (cmap->blue[i] >> (16 - info->var.blue.length)) << info->var.blue.offset |
+				 ((1U << info->var.transp.length) - 1) << info->var.transp.offset;
+		info->pseudo_palette = pal;
+	}
+	if (!ops->fb_fillrect)
+		ops->fb_fillrect = cfb_fillrect;
+	if (!ops->fb_copyarea)
+		ops->fb_copyarea = cfb_copyarea;
+	if (!ops->fb_imageblit)
+		ops->fb_imageblit = cfb_imageblit;
+	info->fbops = ops;
+	pr_info("fb: %s has no drawing operations, using the generic ones%s\n", info->fix.id,
+		pal ? " and a default palette" : "");
+	return true;
+}
+#else
+static inline bool fb_add_missing_drawing_ops(struct fb_info *info) { return false; }
+#endif
+
 static int do_register_framebuffer(struct fb_info *fb_info)
 {
 	int i, ret;
 	struct fb_videomode mode;
+	bool late_console;
 
 	if (fb_check_foreignness(fb_info))
 		return -ENOSYS;
 
+	late_console = fb_add_missing_drawing_ops(fb_info);
+
 	do_remove_conflicting_framebuffers(fb_info->apertures,
 					   fb_info->fix.id,
 					   fb_is_primary_device(fb_info));
@@ -1666,6 +1748,15 @@
 	fb_add_videomode(&mode, &fb_info->modelist);
 	registered_fb[i] = fb_info;
 
+#if IS_BUILTIN(CONFIG_FB_CFB_FILLRECT) && IS_BUILTIN(CONFIG_FB_CFB_COPYAREA) && \
+	IS_BUILTIN(CONFIG_FB_CFB_IMAGEBLIT)
+	if (late_console) {
+		late_console_fb = fb_info;
+		schedule_delayed_work(&fb_late_console, HZ);
+		return 0;
+	}
+#endif
