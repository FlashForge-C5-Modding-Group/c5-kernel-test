ingenicfb: build the Creator 5's KX070 LVDS panel (drivers/panel-kx070.c,
copied in by build.sh)

--- a/module_drivers/drivers/video/fbdev/ingenic/displays/Kconfig
+++ b/module_drivers/drivers/video/fbdev/ingenic/displays/Kconfig
@@ -210,6 +210,12 @@
 	help
 		lcd panel lvds hc070ik25, for ingenicfb drivers.
 
+config STAGE_KX070
+	bool "lvds lcd kx070 480x800 (FlashForge Creator 5)"
+	depends on FB_INGENIC_DISPLAYS_STAGE
+	help
+		The Creator 5's LVDS panel, for ingenicfb drivers.
+
 config STAGE_HC101I35
 	tristate "lvds lcd hc101i35 1280x800"
 	depends on FB_INGENIC_DISPLAYS_STAGE
