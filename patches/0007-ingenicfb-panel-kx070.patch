@@ -30,6 +30,7 @@
 obj-$(CONFIG_STAGE_ATK7016) += panel-atk7016.o
 obj-$(CONFIG_STAGE_HC050IG40031) += panel-hc050ig40031.o
 obj-$(CONFIG_STAGE_HC070IK25) += panel-hc070ik25.o
+obj-$(CONFIG_STAGE_KX070) += panel-kx070.o
 obj-$(CONFIG_STAGE_HC101I35) += panel-hc101i35.o
 obj-$(CONFIG_STAGE_KD055FHFID018B) += panel-kd055fhfid018b.o
