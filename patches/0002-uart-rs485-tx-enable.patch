+/*
+ * Adds the wire time of count characters to tx_time_ns. A new burst (timer not
+ * running) gets half a character more, so the enable stays up past the last
+ * stop bit. Called with rs485_lock held.
+ */
+static void calculate_tx_time(struct uart_ingenic_port *up, int count)
+{
+	u64 ns = (u64)count * up->frame_bits * NSEC_PER_SEC;
+
+	if (!up->rs485_timer_active)
+		ns += (u64)up->frame_bits * NSEC_PER_SEC / 2;
+	if (up->baud)
+		up->tx_time_ns += div_u64(ns, up->baud);
+}
+
+static enum hrtimer_restart rs485_tx_timer_handler(struct hrtimer *timer)
+{
+	struct uart_ingenic_port *up = container_of(timer, struct uart_ingenic_port, rs485_timer);
+	enum hrtimer_restart ret = HRTIMER_NORESTART;
+	unsigned long flags;
+
+	spin_lock_irqsave(&up->rs485_lock, flags);
+	if (up->tx_time_ns) {
+		/* more bytes went out while it ran: wait for those too */
+		hrtimer_forward_now(timer, ns_to_ktime(up->tx_time_ns));
+		up->tx_time_ns = 0;
+		up->rs485_timer_active = 1;
+		ret = HRTIMER_RESTART;
+	} else {
+		up->rs485_timer_active = 0;
+		gpiod_set_value(up->rs485_tx_en, 0);
+	}
+	spin_unlock_irqrestore(&up->rs485_lock, flags);
+	return ret;
+}
+
+/* After count characters went into the FIFO: keep the enable up until they're out */
+static void rs485_sent(struct uart_ingenic_port *up, int count)
+{
+	unsigned long flags;
+
+	if (!up->rs485_tx_en)
+		return;
+	spin_lock_irqsave(&up->rs485_lock, flags);
+	calculate_tx_time(up, count);
+	if (!up->rs485_timer_active) {
+		hrtimer_start(&up->rs485_timer, ns_to_ktime(up->tx_time_ns), HRTIMER_MODE_REL);
+		up->tx_time_ns = 0;
+		up->rs485_timer_active = 1;
+	}
+	spin_unlock_irqrestore(&up->rs485_lock, flags);
+}
