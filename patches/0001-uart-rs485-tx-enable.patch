+static enum hrtimer_restart rs485_tx_timer_handler(struct hrtimer *timer)
+{
+	unsigned long flags;
+	enum hrtimer_restart restart;
+	struct uart_ingenic_port *up = container_of(timer, struct uart_ingenic_port, rs485_timer);
+
+	spin_lock_irqsave(&up->wait_time_lock, flags);
+	if (up->wait_time_ns == 0) {
+		/* nothing sent since the timer started: back to receiving */
+		up->timer_waiting = 0;
+		restart = HRTIMER_NORESTART;
+		gpiod_set_value(up->rs485_tx_enable_gpiod, 0);
+	} else {
+		hrtimer_forward_now(&up->rs485_timer, ktime_set(0, up->wait_time_ns));
+		up->wait_time_ns = 0;
+		up->timer_waiting = 1;
+		restart = HRTIMER_RESTART;
+	}
+	spin_unlock_irqrestore(&up->wait_time_lock, flags);
+	return restart;
+}
