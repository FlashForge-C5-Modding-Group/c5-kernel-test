+/* Adds the wire time of byte bytes to the RS485 transmit-enable wait */
+static void calculate_tx_time(struct uart_ingenic_port *up, int byte)
+{
+	unsigned long long need_wait_ns;
+
+	need_wait_ns = (unsigned long long)byte * up->per_byte_bit * 1000 * 1000 * 1000;
+	if (!up->timer_waiting) {
+		/* Wait for half a byte of sending time to ensure the actual data transmission ends */
+		need_wait_ns += (unsigned long long)up->per_byte_bit * 1000 * 1000 * 1000 / 2;
+	}
+	do_div(need_wait_ns, (unsigned long long)(up->baud));
+	up->wait_time_ns += need_wait_ns;
+}
+
+/* Queues bytes' wire time; the timer drops transmit-enable after the last one */
+static void rs485_tx_done(struct uart_ingenic_port *up, int bytes)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&up->wait_time_lock, flags);
+	calculate_tx_time(up, bytes);
+	if (!up->timer_waiting) {
+		hrtimer_start(&up->rs485_timer, ktime_set(0, up->wait_time_ns), HRTIMER_MODE_REL);
+		up->timer_waiting = 1;
+		up->wait_time_ns = 0;
+	}
+	spin_unlock_irqrestore(&up->wait_time_lock, flags);
+}
